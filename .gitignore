# --- .NET build output ---
bin/
obj/
*.user
*.suo
.vs/
TestResults/

# --- Node / frontend build output ---
node_modules/
dist/
# Vite emits the SPA bundle straight into the API's wwwroot; it is a build artifact.
src/Backend/KanbanBoard.Api/wwwroot/

# --- SQLite runtime state (never commit live databases or their journals) ---
# Patterns use **/ because a slash-containing pattern is otherwise anchored to
# the repo root and would miss src/Backend/KanbanBoard.Api/App_Data.
**/App_Data/*.db
**/App_Data/keys/
**/App_Data/backups/
**/App_Data/*.db-journal
**/App_Data/*.db-wal
**/App_Data/*.db-shm
App_Data/*.db-journal
*.db-journal
*.db-wal
*.db-shm
design-time.db

# --- Test / tooling output ---
playwright-report/
test-results/
coverage/
.e2e-data/

# --- Packaging output ---
artifacts/

# --- IIS stdout logs ---
logs/

# --- Local-only human QA playbook ---
docs/qa/test_plan.md

# --- OS / editor noise ---
.DS_Store
Thumbs.db
.idea/

# --- Local Claude Code tooling ---
.claude/
