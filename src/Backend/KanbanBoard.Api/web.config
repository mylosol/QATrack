<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS in-process hosting definition (spec 6.1).
  - AspNetCoreModuleV2 loads the .NET 8 runtime inside w3wp.exe.
  - hiddenSegments blocks any HTTP request whose path contains "App_Data",
    so the SQLite database can never be downloaded.

  Deliberate deviation from the spec's verbatim sample: the settings are NOT
  wrapped in <location path="." inheritChildApplications="false">. That
  wrapper only stops settings from flowing into child applications nested
  under this site (QATrack has none), and on a real Windows Server it made
  IIS reject the whole file with HTTP 500.19 "Unrecognized attribute
  'inheritChildApplications'" (0x8007000d). Behaviour is otherwise identical.
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
    </handlers>
    <aspNetCore processPath="dotnet" arguments=".\KanbanBoard.Api.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
      <environmentVariables>
        <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
      </environmentVariables>
    </aspNetCore>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="App_Data" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
