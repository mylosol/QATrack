{
  "ConnectionStrings": {
    "Kanban": "Data Source=App_Data/kanban.db;Cache=Shared;Mode=ReadWriteCreate;"
  },
  "AiAgentApi": {
    "ApiKey": "",
    "MaxAgentIdentityLength": 100
  },
  "AccessControl": {
    "SharedPasswordHash": "",
    "SessionDays": 30,
    "LoginAttemptsPerMinute": 5,
    "KeyDirectory": "App_Data/keys"
  },
  "Database": {
    "SeedSampleData": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
