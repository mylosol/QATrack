# QATrack board (ASP.NET Core 8 + SQLite), behind Caddy on 127.0.0.1:5080.
# Installed by deploy/linux/setup-server.sh.
[Unit]
Description=QATrack board
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=qatrack
Group=qatrack
WorkingDirectory=/opt/qatrack/current
ExecStart=/usr/bin/dotnet /opt/qatrack/current/KanbanBoard.Api.dll
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://127.0.0.1:5080
Environment=DOTNET_NOLOGO=1
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
# Secrets and the database live outside the app folder, so deploys never touch them.
Environment=QATRACK_SETTINGS_FILE=/etc/qatrack/appsettings.Production.json
Restart=always
RestartSec=5
# Let in-flight requests (uploads) finish; SQLite closes cleanly on SIGINT.
KillSignal=SIGINT
TimeoutStopSec=30
SyslogIdentifier=qatrack

# Hardening: the app may only write its data folder.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/qatrack

[Install]
WantedBy=multi-user.target
