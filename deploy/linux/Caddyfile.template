# QATrack - Caddy site (generated by setup-server.sh; edit the template in the repo, not this file).
#
# Caddy gets and renews the Let's Encrypt certificate itself and redirects
# HTTP to HTTPS. Behind Cloudflare: SSL/TLS mode "Full (strict)", and leave
# "Always Use HTTPS" off (Caddy redirects; Cloudflare's redirect would block
# the HTTP certificate check). See docs/deploy-digitalocean.md.
{
	{{EMAIL_LINE}}
	servers {
		# The real visitor IP: Cloudflare sends it in CF-Connecting-IP, but only
		# requests coming from Cloudflare's own addresses are believed.
		trusted_proxies static {{CLOUDFLARE_RANGES}}
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

{{DOMAIN}} {
	encode zstd gzip

	# Log files can be 20 MB; leave room for the multipart wrapping.
	request_body {
		max_size 25MB
	}

	reverse_proxy 127.0.0.1:{{APP_PORT}} {
		# One value: the resolved client IP (the app trusts only loopback to set it).
		header_up X-Forwarded-For {client_ip}
		header_up X-Forwarded-Proto {scheme}
	}

	log {
		output file /var/log/caddy/qatrack.log {
			roll_size 20MiB
			roll_keep 5
		}
	}
}
